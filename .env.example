# eMentor Daily Adoption Automation
# Copy to .env.local for local development or configure equivalent values in your host.
# Never commit real secrets.

# Mentor API example configuration
MENTOR_USERNAME=mentor-user@example.com
MENTOR_PASSWORD=replace-with-mentor-password
MENTOR_COMPANY=Example Organization
MENTOR_BASE_URL=https://mentor.example.com
MENTOR_LANGUAGE_CODE=en
MENTOR_REFRESH_SAFETY_WINDOW_MS=300000
MENTOR_REQUEST_TIMEOUT_MS=30000
MENTOR_REQUEST_RETRY_DELAYS_MS=3000,15000,60000,180000

# Mentor log-history persistence
MENTOR_LOG_DATABASE_URL=file:./local-mentor-log.db

# Apps Script adoption bridge
ADOPTION_WEB_APP_URL=https://script.google.com/macros/s/your-deployment-id/exec
ADOPTION_SHARED_SECRET=replace-with-a-long-random-shared-secret

# Runtime example defaults
TZ=Europe/Berlin
REPORTING_TIME_ZONE=Europe/Berlin
REPORTING_OPERATIONAL_RUN_HOUR=18
REPORTING_OPERATIONAL_RUN_MINUTE=15
REPORTING_FINAL_RUN_HOUR=22
REPORTING_FINAL_RUN_MINUTE=30
REPORTING_RUN_GRACE_MINUTES=5
REPORTING_SKIP_WEEKDAYS=0

# Apps Script script properties, configured in Apps Script project settings.
# These are documented here as a setup checklist only.
# ADOPTION_SPREADSHEET_ID=your-google-sheet-id
# ADOPTION_SHARED_SECRET=the-same-shared-secret-as-hosting-provider
# ADOPTION_TIME_ZONE=Europe/Berlin
# ADOPTION_RUN_HOUR=22
# ADOPTION_RUN_MINUTE=30
# ADOPTION_PER_RECIPIENT_EMAIL_ENABLED=false
# ADOPTION_EMAIL_RECIPIENTS=Operations Lead <ops-lead@example.com>,Dispatcher <dispatcher@example.com>
