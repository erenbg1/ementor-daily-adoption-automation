# eMentor Daily Adoption Automation
# Copy to .env.local for local development or configure equivalent values in your host.
# Never commit real secrets.

# Mentor API
MENTOR_USERNAME=mentor-user@example.com
MENTOR_PASSWORD=replace-with-mentor-password
MENTOR_COMPANY=Example Logistics
MENTOR_BASE_URL=https://mentor-api.example.com
MENTOR_LANGUAGE_CODE=en
MENTOR_REFRESH_SAFETY_WINDOW_MS=300000
MENTOR_REQUEST_TIMEOUT_MS=30000
MENTOR_REQUEST_RETRY_DELAYS_MS=3000,15000,60000,180000

# Apps Script adoption bridge
EMENTOR_ADOPTION_WEB_APP_URL=https://script.google.com/macros/s/your-deployment-id/exec
EMENTOR_ADOPTION_SHARED_SECRET=replace-with-a-long-random-shared-secret

# Runtime
TZ=Europe/Berlin

# Apps Script script properties, configured in Apps Script project settings.
# These are documented here as a setup checklist only.
# EMENTOR_ADOPTION_SPREADSHEET_ID=your-google-sheet-id
# EMENTOR_ADOPTION_SHARED_SECRET=the-same-shared-secret-as-hosting-provider
# EMENTOR_ADOPTION_PER_RECIPIENT_EMAIL_ENABLED=false
# EMENTOR_ADOPTION_EMAIL_RECIPIENTS=Operations Lead <ops-lead@example.com>,Dispatcher <dispatcher@example.com>
