{
  "name": "ementor-daily-adoption-automation",
  "version": "0.1.0",
  "private": false,
  "description": "Production-grade automation project for daily eMentor adoption reporting.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "lint": "node --check scripts/mentor-adoption-worker.mjs && node --check scripts/verify-mentor-auth.mjs",
    "test": "vitest run tests/mentor",
    "build": "npm run lint && npm test",
    "mentor:verify": "node scripts/verify-mentor-auth.mjs",
    "adoption:run": "node scripts/mentor-adoption-worker.mjs",
    "adoption:test": "node scripts/mentor-adoption-worker.mjs --run-mode=test"
  },
  "dependencies": {
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/example-org/ementor-daily-adoption-automation.git"
  }
}
