{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "node --check scripts/mentor-adoption-worker.mjs"
  },
  "deploy": {
    "cronSchedule": "0 18 * * 1-6",
    "restartPolicyType": "NEVER",
    "startCommand": "npm run adoption:run -- --run-mode=production"
  }
}
